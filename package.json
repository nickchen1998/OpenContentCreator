{
  "name": "opencontentcreator",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "preview:worker": "wrangler dev -c .output/server/wrangler.json --local --port 3010 --persist-to .wrangler/state --local-upstream localhost:3010"
  },
  "dependencies": {
    "chart.js": "^4.6.1",
    "drizzle-orm": "^0.45.4",
    "nuxt": "^4.4.6",
    "nuxt-auth-utils": "^0.5.20",
    "vue": "^3.5.34",
    "vue-router": "^5.0.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261025.1",
    "drizzle-kit": "^0.31.11",
    "wrangler": "^4.152.0"
  }
}
