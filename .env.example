# 本機開發用：cp .env.example .env 後填值。正式環境用 `wrangler secret put <名稱>`。

# session cookie 的加密密鑰，至少 32 字元
NUXT_SESSION_PASSWORD=

# 加密平台 token 的金鑰，至少 32 字元
NUXT_TOKEN_KEY=

# YouTube：站方在 Google Cloud 申請的 OAuth 用戶端（網頁應用程式），全站共用。
# 已授權的重新導向 URI 要有 https://<網域>/api/youtube/callback
NUXT_YOUTUBE_CLIENT_ID=
NUXT_YOUTUBE_CLIENT_SECRET=
